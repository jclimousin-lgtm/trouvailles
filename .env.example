DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=trouvailles
DB_USER=trouvailles_app
DB_PASS=CHANGER_MOI

# eBay Browse API (OAuth2 client_credentials) — TRV-002. Leboncoin/Vinted
# n'ont besoin d'aucun identifiant (API publiques non authentifiées).
EBAY_CLIENT_ID=CHANGER_MOI
EBAY_CLIENT_SECRET=CHANGER_MOI
EBAY_MARKETPLACE_ID=EBAY_FR
# true -> api.sandbox.ebay.com (identifiants sandbox) ; false -> api.ebay.com (production)
EBAY_SANDBOX=false

# TRV-007 — endpoint de conformité "Marketplace Account Deletion" exigé par
# eBay pour activer l'authentification OAuth en production (voir
# public/ebay-account-deletion.php). Le token est à choisir soi-même
# (32-80 caractères alphanumériques/_/-) et à renseigner à l'identique
# dans developer.ebay.com. L'URL doit correspondre exactement, caractère
# pour caractère, à celle enregistrée côté eBay.
EBAY_DELETION_VERIFICATION_TOKEN=CHANGER_MOI
EBAY_DELETION_ENDPOINT_URL=https://votre-domaine.example/ebay-account-deletion.php
